<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b1020">
<title>Gauri Vyavhare | Portfolio</title>

<style>
:root {
  --bg: #080d1b;
  --panel: #111a2d;
  --text: #f3f6ff;
  --muted: #aab6ce;
  --blue: #72a7ff;
  --cyan: #5ce1e6;
  --line: rgba(255,255,255,.1);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
}

body {
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  background: radial-gradient(circle at 80% 5%, #172750 0, transparent 28%), var(--bg);
  color: var(--text);
  line-height: 1.65;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: min(1120px, 91%);
  margin: auto;
}

header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(8,13,27,.9);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--line);
}

nav {
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.logo {
  font-size: 1.25rem;
  font-weight: 800;
}

.logo span {
  color: var(--cyan);
}

.navlinks {
  display: flex;
  gap: 22px;
  align-items: center;
}

.navlinks a {
  font-size: .92rem;
  color: var(--muted);
}

.navlinks a:hover {
  color: var(--cyan);
}

.menu {
  display: none;
  background: none;
  border: 1px solid var(--line);
  color: var(--text);
  padding: 8px 11px;
  border-radius: 10px;
  font-size: 1.1rem;
  cursor: pointer;
}

.hero {
  min-height: 83vh;
  display: grid;
  grid-template-columns: 1.25fr .75fr;
  align-items: center;
  gap: 55px;
  padding: 78px 0 85px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  border: 1px solid rgba(92,225,230,.25);
  background: rgba(92,225,230,.07);
  padding: 7px 13px;
  border-radius: 999px;
  color: var(--cyan);
  font-size: .84rem;
}

.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--cyan);
}

h1 {
  font-size: clamp(2.8rem, 6vw, 5.1rem);
  line-height: 1.05;
  letter-spacing: -3px;
  margin: 24px 0 18px;
}

.gradient {
  background: linear-gradient(100deg, var(--blue), var(--cyan));
  color: transparent;
  background-clip: text;
  -webkit-background-clip: text;
}

.hero p {
  max-width: 650px;
  color: var(--muted);
  font-size: 1.08rem;
}

.actions {
  display: flex;
  gap: 13px;
  flex-wrap: wrap;
  margin-top: 30px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 19px;
  border-radius: 12px;
  font-weight: 700;
  border: 1px solid var(--line);
  transition: transform .2s;
}

.btn:hover {
  transform: translateY(-3px);
}

.primary {
  background: linear-gradient(110deg, #6c9eff, #5ce1e6);
  color: #07101e;
  border: 0;
}

.secondary {
  background: rgba(255,255,255,.035);
}

.hero-card {
  padding: 28px;
  border-radius: 28px;
  background: linear-gradient(145deg, rgba(114,167,255,.16), rgba(92,225,230,.04));
  border: 1px solid rgba(255,255,255,.12);
  box-shadow: 0 25px 80px rgba(0,0,0,.22);
}

.orb {
  width: 145px;
  height: 145px;
  margin: 5px auto 24px;
  border-radius: 42px;
  display: grid;
  place-items: center;
  background: linear-gradient(145deg, var(--blue), var(--cyan));
  box-shadow: 0 16px 45px rgba(92,225,230,.15);
}

.profile-photo {
  overflow: hidden;
  border: 3px solid rgba(92,225,230,.75);
  transform: rotate(-3deg);
}

.profile-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 24%;
  display: block;
  transform: rotate(3deg) scale(1.05);
}

.hero-card h3 {
  text-align: center;
  font-size: 1.4rem;
}

.hero-card .sub {
  text-align: center;
  color: var(--muted);
  font-size: .92rem;
}

.quickfacts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 24px;
}

.fact {
  padding: 14px;
  border: 1px solid var(--line);
  background: rgba(5,10,22,.28);
  border-radius: 14px;
}

.fact strong {
  display: block;
  color: var(--cyan);
  font-size: 1.1rem;
}

.fact span {
  font-size: .78rem;
  color: var(--muted);
}

section {
  padding: 80px 0;
}

.section-head {
  margin-bottom: 32px;
}

.kicker {
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--cyan);
  font-weight: 800;
  font-size: .75rem;
}

h2 {
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -1.3px;
  margin: 7px 0 8px;
}

.section-head p {
  color: var(--muted);
  max-width: 680px;
}

.about-grid {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 22px;
}

.panel {
  padding: 27px;
  border: 1px solid var(--line);
  border-radius: 22px;
  background: linear-gradient(145deg, #111a2d, #0d1527);
}

.panel p {
  color: var(--muted);
}

.panel h3 {
  margin-bottom: 12px;
  font-size: 1.15rem;
}

.info-list {
  display: grid;
  gap: 13px;
}

.info-row {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.info-icon {
  flex: 0 0 36px;
  height: 36px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: rgba(114,167,255,.12);
  color: var(--blue);
}

.info-row strong {
  display: block;
  font-size: .94rem;
}

.info-row small {
  display: block;
  color: var(--muted);
  font-size: .87rem;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
}

.skill-card {
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: #0d1527;
}

.skill-card h3 {
  font-size: 1.05rem;
  margin-bottom: 15px;
}

.tags {
  display: flex;
  gap: 9px;
  flex-wrap: wrap;
}

.tag {
  font-size: .83rem;
  color: #dbe7ff;
  background: rgba(114,167,255,.1);
  border: 1px solid rgba(114,167,255,.17);
  border-radius: 9px;
  padding: 6px 10px;
}

.projects {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

.project {
  padding: 25px;
  border: 1px solid var(--line);
  border-radius: 21px;
  background: linear-gradient(145deg, #121e35, #0d1527);
  transition: transform .25s, border-color .25s;
}

.project:hover {
  transform: translateY(-5px);
  border-color: rgba(92,225,230,.4);
}

.project-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 17px;
}

.project-icon {
  width: 45px;
  height: 45px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: rgba(92,225,230,.1);
  font-size: 1.35rem;
}

.project-type {
  color: var(--cyan);
  font-size: .75rem;
  font-weight: 750;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.project h3 {
  font-size: 1.25rem;
  margin-bottom: 9px;
}

.project p {
  color: var(--muted);
  font-size: .94rem;
  margin-bottom: 18px;
}

.timeline {
  display: grid;
  gap: 18px;
}

.timeline-item {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 22px;
  padding: 23px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(17,26,45,.65);
}

.time {
  color: var(--cyan);
  font-size: .85rem;
  font-weight: 750;
}

.timeline-item h3 {
  font-size: 1.1rem;
}

.timeline-item .place {
  color: var(--muted);
  font-size: .9rem;
  margin: 3px 0 8px;
}

.timeline-item p {
  color: var(--muted);
  font-size: .94rem;
}

.certificate {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 20px;
  align-items: center;
  padding: 25px;
  border-radius: 22px;
  border: 1px solid rgba(92,225,230,.22);
  background: linear-gradient(110deg, rgba(92,225,230,.08), rgba(114,167,255,.07));
}

.cert-icon {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  border-radius: 17px;
  background: linear-gradient(140deg, var(--blue), var(--cyan));
  color: #07101e;
  font-size: 1.6rem;
}

.certificate h3 {
  font-size: 1.15rem;
}

.certificate p {
  color: var(--muted);
  font-size: .92rem;
}

.cert-label {
  font-size: .78rem;
  color: var(--cyan);
  font-weight: 800;
  border: 1px solid rgba(92,225,230,.3);
  padding: 7px 10px;
  border-radius: 9px;
  white-space: nowrap;
}

.education-grid,
.highlights {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.edu,
.highlight {
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: #0d1527;
}

.edu .year {
  color: var(--cyan);
  font-size: .82rem;
  font-weight: 750;
}

.edu h3 {
  font-size: 1rem;
  margin: 9px 0 6px;
}

.edu p,
.highlight p {
  color: var(--muted);
  font-size: .9rem;
}

.highlight strong {
  display: block;
  font-size: 1.15rem;
  margin-bottom: 5px;
}

footer {
  padding: 28px 0;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: .87rem;
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  flex-wrap: wrap;
}

@media (max-width: 800px) {
  .hero {
    grid-template-columns: 1fr;
    gap: 32px;
    padding-top: 60px;
  }

  .hero-card {
    max-width: 500px;
  }

  .about-grid {
    grid-template-columns: 1fr;
  }

  .skills-grid,
  .education-grid,
  .highlights {
    grid-template-columns: repeat(2, 1fr);
  }

  .navlinks {
    display: none;
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    padding: 20px 5%;
    background: #0b1223;
    border-bottom: 1px solid var(--line);
    flex-direction: column;
    align-items: flex-start;
  }

  .navlinks.open {
    display: flex;
  }

  .menu {
    display: block;
  }

  .projects {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 520px) {
  h1 {
    letter-spacing: -1.8px;
  }

  .skills-grid,
  .education-grid,
  .highlights {
    grid-template-columns: 1fr;
  }

  .timeline-item {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .certificate {
    grid-template-columns: auto 1fr;
  }

  .cert-label {
    grid-column: 1 / -1;
    width: max-content;
  }

  .hero-card {
    padding: 22px;
  }

  section {
    padding: 62px 0;
  }

  .panel {
    padding: 22px;
  }
}
</style>
</head>

