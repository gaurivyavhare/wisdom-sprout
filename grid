
<!DOCTYPE html>
<html>
<head>
    <title>CSS Grid Photo Gallery</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f1f5f9;
        }

        header {
            text-align: center;
            padding: 30px;
            background-color: #1e293b;
            color: white;
        }

        header h1 {
            margin-bottom: 10px;
        }

        /* CSS GRID */

        .gallery {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-auto-rows: 220px;
            gap: 15px;
            padding: 25px;
        }

        .photo {
            position: relative;
            overflow: hidden;
            border-radius: 12px;
        }

        .photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .photo h3 {
            position: absolute;
            bottom: 0;
            width: 100%;
            padding: 15px;
            color: white;
            background: linear-gradient(
                transparent,
                rgba(0, 0, 0, 0.8)
            );
        }

        .photo1 {
            grid-column: span 2;
            grid-row: span 2;
        }

        .photo5 {
            grid-column: span 2;
        }

        footer {
            text-align: center;
            padding: 20px;
            background-color: #1e293b;
            color: white;
        }

        /* Responsive Design */

        @media (max-width: 700px) {
            .gallery {
                grid-template-columns: repeat(2, 1fr);
            }

            .photo1 {
                grid-column: span 2;
                grid-row: span 1;
            }
        }

        @media (max-width: 450px) {
            .gallery {
                grid-template-columns: 1fr;
            }

            .photo1,
            .photo5 {
                grid-column: span 1;
            }
        }

    </style>
</head>

<body>

    <header>
        <h1>My Photo Gallery</h1>
        <p>Explore the Beauty of Nature</p>
    </header>

    <div class="gallery">

        <div class="photo photo1">
            <img src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?w=800">
            <h3>Beautiful Mountains</h3>
        </div>

        <div class="photo">
            <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800">
            <h3>Peaceful Beach</h3>
        </div>

        <div class="photo">
            <img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800">
            <h3>Green Forest</h3>
        </div>

        <div class="photo">
            <img src="https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?w=800">
            <h3>Morning Sunrise</h3>
        </div>

        <div class="photo photo5">
            <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=800">
            <h3>Snowy Mountains</h3>
        </div>

        <div class="photo">
            <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=800">
            <h3>Nature Beauty</h3>
        </div>

    </div>

    <footer>
        <p>Created Using HTML and CSS Grid</p>
    </footer>

</body>
</html>
