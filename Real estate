<title>DreamHome - Real Estate</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f8f9fa;
    color: #222;
}

html {
    scroll-behavior: smooth;
}

button {
    cursor: pointer;
    border: none;
}

/* NAVIGATION */

.navbar {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    align-items: center;
    padding: 18px 6%;
    background: white;
}

.logo {
    font-size: 24px;
    font-weight: bold;
    color: #2796f5;
}

.logo span {
    color: #222;
}

.nav-links {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: center;
    gap: 30px;
}

.nav-links a {
    text-decoration: none;
    color: #333;
    font-size: 14px;
}

.nav-button {
    justify-self: end;
    background: #2995f5;
    color: white;
    padding: 12px 20px;
    border-radius: 5px;
}

/* HERO SECTION */

.hero {
    min-height: 480px;
    background:
    linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.55)),
    url("https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=1600")
    center/cover;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 50px 5%;
}

.hero-content {
    width: 100%;
    max-width: 1050px;
}

.hero h1 {
    font-size: 42px;
    color: white;
    margin-bottom: 10px;
}

.hero p {
    color: white;
    font-size: 19px;
    margin-bottom: 35px;
}

.tabs {
    display: grid;
    grid-template-columns: repeat(3, 110px);
    justify-content: start;
}

.tabs button {
    padding: 12px;
    background: #2995f5;
    color: white;
    border-radius: 5px 5px 0 0;
}

.tabs button:first-child {
    background: white;
    color: #222;
}

.search-box {
    display: grid;
    grid-template-columns: repeat(4, 1fr) 110px;
    gap: 12px;
    background: white;
    padding: 18px;
    border-radius: 10px;
    text-align: left;
}

.search-box label {
    font-size: 11px;
    font-weight: bold;
    display: block;
    margin-bottom: 8px;
}

.search-box select {
    width: 100%;
    padding: 12px 7px;
    border: 1px solid #ddd;
    border-radius: 5px;
}

.search-btn {
    background: #2995f5;
    color: white;
    border-radius: 5px;
    align-self: end;
    padding: 13px;
}

/* COMMON SECTION */

.section {
    padding: 65px 6%;
}

.section-heading {
    text-align: center;
    margin-bottom: 35px;
}

.section-heading h2 {
    font-size: 28px;
    margin-bottom: 10px;
}

.section-heading p {
    color: #888;
    font-size: 14px;
}

/* PROPERTY GRID */

.property-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px 18px;
}

.property-card {
    background: white;
    border-radius: 7px;
    overflow: hidden;
}

.property-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
}

.property-image {
    position: relative;
}

.tag {
    position: absolute;
    top: 12px;
    left: 10px;
    background: #3abf91;
    color: white;
    font-size: 10px;
    padding: 6px 9px;
    border-radius: 3px;
}

.tag.sale {
    background: #6579ca;
}

.property-info {
    padding: 12px;
}

.property-info h3 {
    font-size: 14px;
    margin-bottom: 8px;
}

.property-details {
    color: #777;
    font-size: 11px;
    margin-bottom: 8px;
}

.address {
    color: #888;
    font-size: 11px;
}

.load-more {
    display: block;
    margin: 35px auto 0;
    padding: 12px 35px;
    border: 1px solid #2995f5;
    color: #2995f5;
    background: white;
    border-radius: 5px;
}

/* WIDE SELECTION */

.wide-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr;
    grid-template-rows: 180px 180px;
    gap: 12px;
}

.wide-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
}

.wide-grid .large-image {
    grid-row: span 2;
}

.wide-text {
    padding: 15px;
}

.wide-text h2 {
    font-size: 23px;
    margin-bottom: 12px;
}

.wide-text p {
    font-size: 13px;
    color: #777;
    line-height: 1.7;
}

/* WHY CHOOSE US */

.why-section {
    background:
    linear-gradient(rgba(10,42,65,.75),rgba(10,42,65,.75)),
    url("https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1500")
    center/cover;
    padding: 65px 6%;
}

.why-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 45px;
    align-items: center;
}

.why-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    color: white;
}

.why-content h2 {
    grid-column: span 2;
    font-size: 30px;
}

.reason h3 {
    margin-bottom: 10px;
    font-size: 20px;
}

.reason p {
    font-size: 13px;
    line-height: 1.7;
    color: #eee;
}

.inquiry-form {
    background: white;
    padding: 25px;
    border-radius: 10px;
}

.inquiry-form h3 {
    margin-bottom: 18px;
}

.inquiry-form label {
    display: block;
    font-size: 12px;
    margin: 12px 0 6px;
}

.inquiry-form input,
.inquiry-form select,
.inquiry-form textarea {
    width: 100%;
    padding: 11px;
    border: 1px solid #ddd;
    border-radius: 4px;
}

.inquiry-form textarea {
    height: 75px;
    resize: vertical;
}

.inquiry-form button {
    background: #2995f5;
    color: white;
    width: 100%;
    padding: 12px;
    margin-top: 15px;
    border-radius: 4px;
}

/* FEATURED LISTINGS */

.featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.featured-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
}

.featured-card img {
    width: 100%;
    height: 210px;
    object-fit: cover;
}

.featured-card h3 {
    padding: 12px;
    font-size: 15px;
}

.featured-card p {
    padding: 0 12px 15px;
    color: #888;
    font-size: 12px;
}

/* TESTIMONIALS */

.testimonials {
    text-align: center;
}

.testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 35px;
    margin-top: 35px;
}

.testimonial {
    padding: 20px;
}

.testimonial img {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 12px;
}

.testimonial h3 {
    font-size: 16px;
    margin-bottom: 6px;
}

.testimonial small {
    color: #999;
}

.testimonial p {
    margin-top: 15px;
    font-size: 14px;
    line-height: 1.6;
}

/* NEWSLETTER AND FOOTER */

.newsletter {
    background: #2995f5;
    padding: 20px 6%;
    color: white;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
}

.newsletter input {
    width: 100%;
    padding: 13px;
    border-radius: 25px;
    border: none;
}

.footer {
    background: #303030;
    color: white;
    padding: 45px 6% 20px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 30px;
}

.footer h3 {
    margin-bottom: 15px;
}

.footer p,
.footer a {
    color: #ccc;
    font-size: 13px;
    line-height: 1.8;
    text-decoration: none;
}

.footer-bottom {
    text-align: center;
    border-top: 1px solid #555;
    padding-top: 20px;
    margin-top: 30px;
    font-size: 12px;
}

/* RESPONSIVE DESIGN */

@media(max-width: 900px) {
    .property-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .navbar {
        grid-template-columns: 1fr 2fr;
    }

    .nav-button {
        display: none;
    }

    .why-grid {
        grid-template-columns: 1fr;
    }
}

@media(max-width: 600px) {
    .navbar {
        grid-template-columns: 1fr;
        gap: 18px;
        text-align: center;
    }

    .nav-links {
        grid-template-columns: repeat(2, auto);
        gap: 15px;
    }

    .hero h1 {
        font-size: 28px;
    }

    .search-box {
        grid-template-columns: 1fr 1fr;
    }

    .search-btn {
        grid-column: span 2;
    }

    .tabs {
        grid-template-columns: repeat(3, 1fr);
    }

    .property-grid {
        grid-template-columns: 1fr;
    }

    .wide-grid {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 200px 150px 150px;
    }

    .wide-grid .large-image {
        grid-column: span 2;
        grid-row: span 1;
    }

    .wide-text {
        grid-column: span 2;
    }

    .why-content {
        grid-template-columns: 1fr;
    }

    .why-content h2 {
        grid-column: span 1;
    }

    .featured-grid,
    .testimonial-grid {
        grid-template-columns: 1fr;
    }

    .newsletter {
        grid-template-columns: 1fr;
        gap: 15px;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }
}
</style>
</head>

