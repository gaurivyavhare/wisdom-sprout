
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GameZone | Gaming Navbar</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #090b14;
            color: white;
            min-height: 100vh;
        }

        /* Navbar */
        .navbar {
            width: 100%;
            min-height: 78px;
            padding: 15px 6%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            background: #111421;
            border-bottom: 1px solid #292e43;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 27px;
            font-weight: 900;
            color: #00f5ff;
            text-decoration: none;
            white-space: nowrap;
            text-shadow: 0 0 15px #00f5ff66;
        }

        .logo span {
            color: #ff3cac;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
            list-style: none;
        }

        .nav-links a {
            color: #c7c9d6;
            text-decoration: none;
            font-size: 15px;
            font-weight: bold;
            transition: 0.3s;
            position: relative;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: #00f5ff;
            text-shadow: 0 0 12px #00f5ff77;
        }

        .nav-links a::after {
            content: "";
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -8px;
            left: 0;
            background: #00f5ff;
            transition: width 0.3s;
        }

        .nav-links a:hover::after,
        .nav-links a.active::after {
            width: 100%;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .search-box {
            width: 150px;
            padding: 10px 12px;
            background: #1b2031;
            color: white;
            border: 1px solid #343a52;
            border-radius: 8px;
            outline: none;
        }

        .search-box:focus {
            border-color: #00f5ff;
        }

        .play-btn {
            padding: 11px 18px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(90deg, #00d9ff, #9b5cff);
            color: #080b16;
            font-weight: 900;
            cursor: pointer;
            transition: 0.3s;
            white-space: nowrap;
        }

        .play-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 22px #00d9ff77;
        }

        .menu-toggle {
            display: none;
            background: transparent;
            border: none;
            color: white;
            font-size: 29px;
            cursor: pointer;
        }

        /* Demo content */
        .hero {
            min-height: 75vh;
            padding: 80px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            background:
                radial-gradient(ellipse at top, #19264c 0%, transparent 60%),
                #090b14;
        }

        .tag {
            color: #00f5ff;
            letter-spacing: 4px;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: clamp(38px, 7vw, 76px);
            line-height: 1.1;
            margin-bottom: 22px;
        }

        .hero h1 span {
            color: #ff3cac;
            text-shadow: 0 0 25px #ff3cac55;
        }

        .hero p {
            color: #a7adc3;
            max-width: 550px;
            line-height: 1.8;
            margin-bottom: 28px;
        }

        .message {
            color: #00f5ff;
            margin-top: 22px;
            min-height: 24px;
        }

        @media (max-width: 1050px) {
            .navbar {
                padding: 15px 4%;
                gap: 15px;
            }

            .nav-links {
                gap: 16px;
            }

            .search-box {
                width: 120px;
            }
        }

        @media (max-width: 800px) {
            .menu-toggle {
                display: block;
            }

            .navbar {
                flex-wrap: wrap;
            }

            .nav-links {
                display: none;
                width: 100%;
                flex-direction: column;
                align-items: stretch;
                gap: 0;
                order: 3;
            }

            .nav-links.open {
                display: flex;
            }

            .nav-links li a {
                display: block;
                padding: 15px 5px;
            }

            .nav-links a::after {
                display: none;
            }

            .nav-actions {
                margin-left: auto;
            }

            .search-box {
                display: none;
            }
        }

        @media (max-width: 430px) {
            .navbar {
                gap: 12px;
            }

            .logo {
                font-size: 22px;
            }

            .play-btn {
                padding: 10px 12px;
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar">
        <a href="#home" class="logo">GAME<span>ZONE</span></a>

        <button class="menu-toggle" id="menuToggle"
                aria-label="Toggle navigation"
                aria-expanded="false">
            ☰
        </button>

        <ul class="nav-links" id="navLinks">
            <li><a href="#home" class="active">Home</a></li>
            <li><a href="#games">Games</a></li>
            <li><a href="#tournaments">Tournaments</a></li>
            <li><a href="#leaderboard">Leaderboard</a></li>
            <li><a href="#about">About</a></li>
        </ul>

        <div class="nav-actions">
            <input type="search" class="search-box"
                   id="gameSearch" placeholder="Search games..."
                   aria-label="Search games">
            <button class="play-btn" id="playButton">PLAY NOW ↗</button>
        </div>
    </nav>

    <main class="hero" id="home">
        <div class="tag">LEVEL UP YOUR GAME</div>

        <h1>ENTER THE<br><span>GAMING WORLD</span></h1>

        <p>
            Discover epic adventures, challenge your friends,
            join tournaments, and climb to the top of the
            leaderboard. Your next victory starts here.
        </p>

        <button class="play-btn" id="exploreButton">
            EXPLORE GAMES 🎮
        </button>

        <div class="message" id="message" aria-live="polite"></div>
    </main>

    <script>
        const menuToggle = document.getElementById("menuToggle");
        const navLinks = document.getElementById("navLinks");
        const message = document.getElementById("message");

        // Mobile navigation toggle
        menuToggle.addEventListener("click", function () {
            const isOpen = navLinks.classList.toggle("open");

            menuToggle.textContent = isOpen ? "✕" : "☰";
            menuToggle.setAttribute("aria-expanded", isOpen);
        });

        // Active navigation link
        document.querySelectorAll(".nav-links a").forEach(link => {
            link.addEventListener("click", function () {
                document.querySelectorAll(".nav-links a")
                    .forEach(item => item.classList.remove("active"));

                this.classList.add("active");
                message.textContent = "You selected: " +
                    this.textContent;

                navLinks.classList.remove("open");
                menuToggle.textContent = "☰";
                menuToggle.setAttribute("aria-expanded", "false");
            });
        });

        // Play Now button
        document.getElementById("playButton")
            .addEventListener("click", function () {
                message.textContent =
                    "GameZone is ready! Add your game page to start playing.";
            });

        // Explore Games button
        document.getElementById("exploreButton")
            .addEventListener("click", function () {
                message.textContent =
                    "Your game library will appear here. Stay tuned!";
            });

        // Search interaction
        document.getElementById("gameSearch")
            .addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    const query = this.value.trim();

                    message.textContent = query
                        ? "Searching for: " + query
                        : "Please enter a game name.";
                }
            });
    </script>

</body>
</html>
